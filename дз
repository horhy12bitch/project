// 1
let name = prompt("1. Введіть ваше ім'я:");
alert("Привіт, " + name + "!");

// 2
const currentYear = 2026;
let birthYear = Number(prompt("2. Введіть ваш рік народження:"));
let age = currentYear - birthYear;
alert("Вам " + age + " років.");

// 3
let side = Number(prompt("3. Введіть довжину сторони квадрата:"));
let perimeter = side * 4;
alert("Периметр квадрата: " + perimeter);

// 4
let radius = Number(prompt("4. Введіть радіус кола:"));
let area = Math.PI * radius * radius;
alert("Площа кола: " + area);

// 5
let distance = Number(prompt("5. Введіть відстань між містами в км:"));
let hours = Number(prompt("За скільки годин хочете дістатися?"));
let speed = distance / hours;
alert("Потрібна швидкість: " + speed + " км/год");

// 6
const euroRate = 0.92;
let dollars = Number(prompt("6. Введіть суму в доларах:"));
let euros = dollars * euroRate;
alert("Сума в євро: " + euros);

// 7
let flashGB = Number(prompt("7. Введіть обсяг флешки в ГБ:"));
let flashMB = flashGB * 1024;
let files = Math.floor(flashMB / 820);
alert("На флешку поміститься " + files + " файлів.");

// 8
let money = Number(prompt("8. Скільки грошей у вас є?"));
let chocolatePrice = Number(prompt("Скільки коштує одна шоколадка?"));
let chocolates = Math.floor(money / chocolatePrice);
let change = money % chocolatePrice;
alert("Шоколадок: " + chocolates + "\nЗдача: " + change);

// 9
let number = Number(prompt("9. Введіть тризначне число:"));
let a = Math.floor(number / 100);
let b = Math.floor(number / 10) % 10;
let c = number % 10;
let reverse = c * 100 + b * 10 + a;
alert("Число-перевертень: " + reverse);

// 10
let number2 = Number(prompt("10. Введіть ціле число:"));
let result = (number2 % 2 === 0 && "Парне") || (number2 % 2 !== 0 && "Непарне");
alert(result);
